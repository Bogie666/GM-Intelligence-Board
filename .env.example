# Demo mode requires no secrets.
NEXT_PUBLIC_DEMO_MODE=true

# Production implementation (not used by this prototype):
# DATABASE_URL=
# AUTH_SECRET=
# CONFIG_ENCRYPTION_KEY=
# SERVICETITAN_CLIENT_ID=
# SERVICETITAN_CLIENT_SECRET=

# Domo DataSet API — server-only configuration
DOMO_CLIENT_ID=
DOMO_CLIENT_SECRET=

# Comma-separated Domo dataset IDs approved for this application.
# Reads for IDs outside this list are denied by the connector.
DOMO_ALLOWED_DATASET_IDS=

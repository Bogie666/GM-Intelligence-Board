# Application mode is server-owned and must be explicit.
# demo: browser-local prototype; staging/production: authenticated Supabase control plane.
APP_MODE=demo

# Supabase staging configuration
# NEXT_PUBLIC_SUPABASE_ANON_KEY is publishable and RLS-constrained.
# SUPABASE_URL is the server-pinned origin used by trusted Admin workers and must
# exactly match NEXT_PUBLIC_SUPABASE_URL. The service key is never browser-exposed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.your-project-ref:***@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.your-project-ref:***@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Protected operator/bootstrap scope and immutable release identity.
GM_PLATFORM_OWNER_PROFILE_ID=
GM_DEFAULT_PORTFOLIO_ID=c1000000-0000-4000-8000-000000000001
GM_BUILD_SHA=

# Optional server-only Domo connector
DOMO_CLIENT_ID=
DOMO_CLIENT_SECRET=
DOMO_ALLOWED_DATASET_IDS=
